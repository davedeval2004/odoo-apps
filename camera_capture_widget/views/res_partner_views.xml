<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Apply camera widget to Contact form image field -->
    <record id="view_partner_form_camera_capture_widget" model="ir.ui.view">
        <field name="name">res.partner.form.camera.capture.widget</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="attributes">
                <attribute name="widget">camera</attribute>
            </xpath>
        </field>
    </record>

</odoo>
